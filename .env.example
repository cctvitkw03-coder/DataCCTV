# Demo uses browser fixtures only; no external writes. Live requires every applicable value.
APP_MODE=demo
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Supabase transaction pooler connection, server only; TLS verified
DATABASE_URL=
# Downloaded Supabase CA PEM; use literal \n between certificate lines if needed.
DATABASE_SSL_CA=
APP_WORKSPACE_ID=
TELEGRAM_BOT_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
WORKER_AUTH_SECRET=
CRON_SECRET=
GOOGLE_DRIVE_AUTH_MODE=oauth
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# service_account mode requires Shared Drive
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHARED_DRIVE_ID=
APP_TIMEZONE=Asia/Bangkok
SESSION_TTL_HOURS=24
# Optional override only; default remains 24 hours per v2.
# SESSION_TTL_MINUTES=1440
# Also requires allowed_chats.groups_enabled=true for each tested group.
TELEGRAM_GROUPS_ENABLED=false
# Server-only 32-byte random key encoded as base64, used for stored OAuth tokens.
OAUTH_ENCRYPTION_KEY=
MAX_FILES_PER_SESSION=50
MAX_FILE_BYTES=19000000
MAX_RETRY_ATTEMPTS=5
